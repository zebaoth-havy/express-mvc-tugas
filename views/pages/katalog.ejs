<%- include('../partials/header', { title }) %>
<section>
  <p class="eyebrow">DATA PRODUK</p>
  <h1>Katalog Data</h1>
  <p>Daftar berikut dirender secara dinamis dari array object pada controller.</p>

  <div class="product-grid">
    <% produk.forEach(function(item) { %>
      <article class="card product">
        <h2><%= item.nama %></h2>
        <p>Kategori: <%= item.kategori %></p>
        <p class="price">Rp <%= item.harga.toLocaleString('id-ID') %></p>
      </article>
    <% }); %>
  </div>
</section>

<section class="card form-card">
  <h2>Form Tambah Data</h2>
  <p>Isi ketiga kolom berikut untuk menguji HTTP POST.</p>
  <form action="/katalog/tambah" method="POST">
    <label for="nama">Nama produk (teks)</label>
    <input type="text" id="nama" name="nama" required>

    <label for="harga">Harga (angka)</label>
    <input type="number" id="harga" name="harga" min="0" required>

    <label for="kategori">Kategori (dropdown)</label>
    <select id="kategori" name="kategori" required>
      <option value="">-- Pilih kategori --</option>
      <option value="Elektronik">Elektronik</option>
      <option value="Buku">Buku</option>
      <option value="Aksesori">Aksesori</option>
    </select>

    <button class="button" type="submit">Kirim Data</button>
  </form>
</section>
<%- include('../partials/footer') %>
